# Copy to .env (never commit .env). Everything runs with LLM_PROVIDER=fake and no keys.
LLM_PROVIDER=fake            # fake | anthropic | openai
# LLM_MODEL=claude-sonnet-5-5  # defaults per provider
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LOG_LEVEL=INFO

# Review queue
REVIEW_DB_URL=sqlite:///review_queue.db
# FDE_REVIEW_API_KEY=change-me

# SQL connector (read-only role recommended)
FDE_SQL_URL=sqlite:///:memory:
FDE_SQL_QUERY=SELECT 1 AS ok

# IMAP connector
# FDE_IMAP_HOST=imap.example.com
# FDE_IMAP_USERNAME=agent@example.com
# FDE_IMAP_PASSWORD=
# FDE_IMAP_MAILBOX=INBOX

# Drop-folder connector
FDE_DROP_PATH=./drop

# Webhook connector (HMAC-SHA256 over the body, header X-Signature: sha256=<hex>)
# FDE_WEBHOOK_SECRET=change-me

# Optional tracing: switches on only when set
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
